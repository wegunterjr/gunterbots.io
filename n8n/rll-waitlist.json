{
  "name": "RLL waitlist → Moodle",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "rll-waitlist",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "wh",
      "name": "Waitlist webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "rll-waitlist"
    },
    {
      "parameters": {
        "jsCode": "const b = $input.first().json.body || $input.first().json;\nconst name = String(b.name || '').trim();\nconst email = String(b.email || '').trim().toLowerCase();\nif (!email || !email.includes('@')) throw new Error('email required');\nconst parts = name.split(/\\s+/).filter(Boolean);\nconst firstname = parts[0] || 'Parent';\nconst lastname = parts.slice(1).join(' ') || 'Crew';\nconst local = email.split('@')[0].toLowerCase().replace(/[^a-z0-9._-]/g, '');\nconst username = (local || 'parent').slice(0, 40);\nreturn [{\n  json: {\n    name, email, firstname, lastname, username,\n    builder: b.builder || '',\n    tier: b.tier || '',\n    calendar: b.calendar || '',\n    note: b.note || '',\n    sentinel: /sentinel/i.test(String(b.note || ''))\n  }\n}];"
      },
      "id": "norm",
      "name": "Normalize signup",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.MOODLE_URL}}/webservice/rest/server.php",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            { "name": "wstoken", "value": "={{$env.MOODLE_TOKEN}}" },
            { "name": "wsfunction", "value": "core_user_get_users_by_field" },
            { "name": "moodlewsrestformat", "value": "json" },
            { "name": "field", "value": "email" },
            { "name": "values[0]", "value": "={{$json.email}}" }
          ]
        },
        "options": {}
      },
      "id": "lookup",
      "name": "Find Moodle user",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 0]
    },
    {
      "parameters": {
        "jsCode": "const signup = $('Normalize signup').first().json;\nconst found = $input.first().json;\nconst list = Array.isArray(found) ? found : (found.body || []);\nconst existing = Array.isArray(list) && list[0] && list[0].id ? list[0] : null;\nreturn [{ json: { ...signup, existingId: existing ? existing.id : null, created: !existing } }];"
      },
      "id": "decide",
      "name": "Existing or new",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 0]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{!!$json.existingId}}",
              "value2": false
            }
          ]
        }
      },
      "id": "ifnew",
      "name": "Need create?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [960, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.MOODLE_URL}}/webservice/rest/server.php",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            { "name": "wstoken", "value": "={{$env.MOODLE_TOKEN}}" },
            { "name": "wsfunction", "value": "core_user_create_users" },
            { "name": "moodlewsrestformat", "value": "json" },
            { "name": "users[0][username]", "value": "={{$json.username}}" },
            { "name": "users[0][firstname]", "value": "={{$json.firstname}}" },
            { "name": "users[0][lastname]", "value": "={{$json.lastname}}" },
            { "name": "users[0][email]", "value": "={{$json.email}}" },
            { "name": "users[0][auth]", "value": "manual" },
            { "name": "users[0][createpassword]", "value": "1" }
          ]
        },
        "options": {}
      },
      "id": "create",
      "name": "Create Moodle user",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, -140]
    },
    {
      "parameters": {
        "jsCode": "const signup = $('Existing or new').first().json;\nconst created = $input.first().json;\nconst row = Array.isArray(created) ? created[0] : created;\nconst id = signup.existingId || row.id || (row[0] && row[0].id);\nif (!id) throw new Error('No Moodle user id: ' + JSON.stringify(created).slice(0, 400));\nreturn [{ json: { ...signup, userid: id } }];"
      },
      "id": "id",
      "name": "User id",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1440, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.MOODLE_URL}}/webservice/rest/server.php",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            { "name": "wstoken", "value": "={{$env.MOODLE_TOKEN}}" },
            { "name": "wsfunction", "value": "enrol_manual_enrol_users" },
            { "name": "moodlewsrestformat", "value": "json" },
            { "name": "enrolments[0][roleid]", "value": "={{$env.RLL_ROLE_ID}}" },
            { "name": "enrolments[0][userid]", "value": "={{$json.userid}}" },
            { "name": "enrolments[0][courseid]", "value": "={{$env.RLL_COURSE_ID}}" }
          ]
        },
        "options": {}
      },
      "id": "enrol",
      "name": "Enrol in Robot Logic Lab",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1680, 0]
    },
    {
      "parameters": {
        "fromEmail": "hello@gunterbots.com",
        "toEmail": "={{$env.NOTIFY_EMAIL}}",
        "subject": "=RLL signup: {{$('User id').item.json.email}}",
        "text": "=New waitlist\n\nName: {{$('User id').item.json.name}}\nEmail: {{$('User id').item.json.email}}\nBuilder: {{$('User id').item.json.builder}}\nSeat: {{$('User id').item.json.tier}}\nCalendar: {{$('User id').item.json.calendar}}\nNote: {{$('User id').item.json.note}}\nMoodle user id: {{$('User id').item.json.userid}}\nCreated new login: {{$('User id').item.json.created}}\nSentinel crew: {{$('User id').item.json.sentinel}}\n\nThey should get a Moodle email to set a password, then log in at https://learn.mgit.io"
      },
      "id": "mail",
      "name": "Ping Walter",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1920, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"ok\": true }",
        "options": {
          "responseHeaders": {
            "entries": [
              { "name": "Access-Control-Allow-Origin", "value": "*" }
            ]
          }
        }
      },
      "id": "ok",
      "name": "Respond ok",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [2160, 0]
    }
  ],
  "connections": {
    "Waitlist webhook": { "main": [[{ "node": "Normalize signup", "type": "main", "index": 0 }]] },
    "Normalize signup": { "main": [[{ "node": "Find Moodle user", "type": "main", "index": 0 }]] },
    "Find Moodle user": { "main": [[{ "node": "Existing or new", "type": "main", "index": 0 }]] },
    "Existing or new": { "main": [[{ "node": "Need create?", "type": "main", "index": 0 }]] },
    "Need create?": {
      "main": [
        [{ "node": "Create Moodle user", "type": "main", "index": 0 }],
        [{ "node": "User id", "type": "main", "index": 0 }]
      ]
    },
    "Create Moodle user": { "main": [[{ "node": "User id", "type": "main", "index": 0 }]] },
    "User id": { "main": [[{ "node": "Enrol in Robot Logic Lab", "type": "main", "index": 0 }]] },
    "Enrol in Robot Logic Lab": { "main": [[{ "node": "Ping Walter", "type": "main", "index": 0 }]] },
    "Ping Walter": { "main": [[{ "node": "Respond ok", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "pinData": {},
  "meta": { "templateCredsSetupCompleted": false }
}
